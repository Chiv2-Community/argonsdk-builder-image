{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArgonSDK content-mod descriptor v1",
  "type": "object",
  "required": ["name", "repository", "commit", "package_path"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1, "default": 1},
    "name": {"$ref": "#/$defs/name"},
    "repository": {"$ref": "#/$defs/repository"},
    "commit": {"$ref": "#/$defs/commit"},
    "content_path": {"$ref": "#/$defs/contentPath", "default": "Content"},
    "package_path": {"$ref": "#/$defs/packagePath"},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/input"}, "default": []}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"},
    "repository": {"type": "string", "pattern": "^https://[^\\s]+$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "contentPath": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_. -]*(/[A-Za-z0-9_][A-Za-z0-9_. -]*)*$"},
    "packagePath": {"type": "string", "pattern": "^Mods/[A-Za-z0-9_]+(/[A-Za-z0-9_]+)*$"},
    "input": {
      "type": "object",
      "required": ["name", "repository", "commit", "package_path"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1, "default": 1},
        "name": {"$ref": "#/$defs/name"},
        "repository": {"$ref": "#/$defs/repository"},
        "commit": {"$ref": "#/$defs/commit"},
        "content_path": {"$ref": "#/$defs/contentPath", "default": "Content"},
        "package_path": {"$ref": "#/$defs/packagePath"}
      }
    }
  },
  "$comment": "CLI validation additionally rejects reserved Windows names, trailing dots/spaces, URL credentials/query/fragment, and case-insensitive overlapping package namespaces."
}
